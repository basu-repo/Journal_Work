Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground grid
      Enabled: true
      Plane: XY
      Cell Size: 1
      Color: 80; 80; 80
      Alpha: 0.5
    - Class: rviz_default_plugins/Map
      Name: SLAM map
      Enabled: true
      Alpha: 0.7
      Topic:
        Value: /map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/LaserScan
      Name: Navigation scan
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Points
      Size (Pixels): 8
      Color: 255; 0; 0
      Decay Time: 3
    - Class: rviz_default_plugins/PointCloud2
      Name: FAST-LIO2 registered 3D LiDAR
      Enabled: true
      Topic:
        Value: /cloud_registered
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 2
      Style: Flat Squares
      Size (Pixels): 5
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 5
    - Class: rviz_default_plugins/Path
      Name: Planned route
      Enabled: true
      Topic:
        Value: /dijkstra_lattice/path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Line Style: Lines
      Line Width: 0.05
      Color: 0; 255; 0
    - Class: rviz_default_plugins/PoseArray
      Name: Mission waypoints and goal
      Enabled: true
      Topic:
        Value: /navigation/mission_targets
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Shape: Arrow (Flat)
      Color: 0; 170; 255
      Alpha: 1
      Shaft Length: 0.4
      Shaft Radius: 0.05
      Head Length: 0.15
      Head Radius: 0.1
    - Class: rviz_default_plugins/Odometry
      Name: FAST-LIO2 base pose
      Enabled: true
      Topic:
        Value: /fastlio/odometry_base
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Keep: 100
      Shape:
        Value: Arrow
        Color: 255; 180; 0
        Alpha: 1
    - Class: rviz_default_plugins/RobotModel
      Name: Husky model
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/TF
      Name: TF tree
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.5
      Show Arrows: true
      Show Axes: true
      Show Names: true
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top-down mission view
      Scale: 25
      Angle: 0
      X: 0
      Y: 0
Window Geometry:
  Width: 1280
  Height: 800
